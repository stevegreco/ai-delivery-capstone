<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or page.fileSlug }} · AI Delivery Capstone</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Lora:wght@500&family=Source+Sans+3:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/tokens.css">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--semantic-color-background-default);
      color: var(--semantic-color-foreground-default);
      font-family: var(--semantic-typography-body-default-font-family);
      font-size: var(--semantic-typography-body-default-font-size);
      line-height: var(--primitives-leading-relaxed);
    }
    header, main { max-width: var(--primitives-layout-prose); margin: 0 auto; padding: 0 var(--primitives-space-4); }
    header {
      display: flex; flex-wrap: wrap; gap: var(--primitives-space-1) var(--primitives-space-4); align-items: baseline;
      padding-top: var(--primitives-space-5); padding-bottom: var(--primitives-space-3);
      border-bottom: var(--primitives-border-thin) solid var(--semantic-color-border-subtle);
    }
    header a {
      color: var(--semantic-color-foreground-default); text-decoration: none;
      font-family: var(--semantic-typography-label-default-font-family);
      font-weight: var(--primitives-weight-semibold);
    }
    header span {
      color: var(--semantic-color-foreground-muted);
      font-family: var(--semantic-typography-eyebrow-font-family);
      font-size: var(--semantic-typography-eyebrow-font-size);
      font-weight: var(--semantic-typography-eyebrow-font-weight);
      letter-spacing: var(--semantic-typography-eyebrow-letter-spacing);
      text-transform: uppercase;
    }
    main { padding-bottom: var(--primitives-space-16); }
    a { color: var(--semantic-color-foreground-brand-default); }
    a:focus-visible { outline: var(--primitives-border-thick) solid var(--semantic-color-border-focus); outline-offset: 2px; }
    h1 {
      font-family: var(--semantic-typography-heading-large-font-family);
      font-size: var(--semantic-typography-heading-large-font-size);
      font-weight: var(--semantic-typography-heading-large-font-weight);
      line-height: var(--semantic-typography-heading-large-line-height);
      letter-spacing: var(--semantic-typography-heading-large-letter-spacing);
    }
    h2 {
      font-family: var(--semantic-typography-heading-default-font-family);
      font-size: var(--semantic-typography-heading-default-font-size);
      font-weight: var(--semantic-typography-heading-default-font-weight);
      line-height: var(--semantic-typography-heading-default-line-height);
      letter-spacing: var(--semantic-typography-heading-default-letter-spacing);
      margin-top: var(--primitives-space-10);
    }
    h3 {
      font-family: var(--semantic-typography-heading-small-font-family);
      font-size: var(--semantic-typography-heading-small-font-size);
      font-weight: var(--semantic-typography-heading-small-font-weight);
      line-height: var(--semantic-typography-heading-small-line-height);
      letter-spacing: var(--semantic-typography-heading-small-letter-spacing);
      margin-top: var(--primitives-space-8);
    }
    table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: var(--semantic-typography-body-small-font-size); }
    th, td {
      border: var(--primitives-border-thin) solid var(--semantic-color-border-subtle);
      padding: var(--primitives-space-2) var(--primitives-space-3);
      text-align: left; vertical-align: top;
    }
    th { background: var(--semantic-color-background-sunken); font-weight: var(--primitives-weight-semibold); }
    code {
      font-family: var(--semantic-typography-code-default-font-family);
      font-size: 0.875em;
      background: var(--semantic-color-background-sunken);
      padding: 0.1em 0.3em; border-radius: var(--primitives-radius-xs);
    }
    pre {
      background: var(--semantic-color-background-sunken);
      padding: var(--primitives-space-4); border-radius: var(--primitives-radius-sm); overflow-x: auto;
    }
    pre code { padding: 0; background: none; }
    hr { border: 0; border-top: var(--primitives-border-thin) solid var(--semantic-color-border-subtle); margin: var(--primitives-space-8) 0; }
    .muted { color: var(--semantic-color-foreground-muted); }
  </style>
</head>
<body>
  <header>
    <a href="/">AI Delivery Capstone</a>
    <span>Learning log · Oct 19 – Dec 13, 2026</span>
  </header>
  <main>
    {{ content | safe }}
  </main>
</body>
</html>
